# Output configurations
Output demo.gif
Output demo.mp4

# Terminal settings
Set FontSize 16
Set Width 1200
Set Height 800
Set Padding 20
Set Theme "Catppuccin Mocha"

# Initial setup delays
Set TypingSpeed 75ms
Sleep 500ms

# Build step
Type "make clean && make"
Enter
Sleep 1.5s

# Run the program
Type "./UNFOCUSED_AI_REFACTOR"
Enter

# Let the program output and ANSI animations run
Sleep 20s
